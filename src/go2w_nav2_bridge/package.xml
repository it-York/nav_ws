<?xml version="1.0"?>
<package format="3">
  <name>go2w_nav2_bridge</name>
  <version>0.1.0</version>
  <description>Fail-safe Nav2 cmd_vel and motion-mode bridge for Unitree Go2W.</description>
  <maintainer email="nvidia@example.com">Koala Nav2 maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>unitree_api</depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
